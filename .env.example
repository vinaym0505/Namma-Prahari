# ==============================================================================
# Namma Prahari — Environment Configuration
# Copy this file to .env and fill in your actual values.
# Both admin_portal and department_portal read from this root .env file
# via Vite's envDir configuration.
# ==============================================================================

# Supabase Configuration (Free Tier)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Maps API Key (Optional — falls back to Leaflet/OpenStreetMap if blank)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Google OAuth Client ID (for web portals — also configured in Supabase dashboard)
VITE_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
